################################################################################
# partition_dna
# Generated by dsh-revbayes-forge 0.1.0
# Analysis: partitioned (2 partitions)
# Data: data/demo_dna.nex, data/demo_dna.nex
#
# Review this script and the paths before running it. The data files must be
# readable from the working directory in which RevBayes is started.
################################################################################


###################################
# Reading in the Partitioned Data #
###################################

data_cytb <- readDiscreteCharacterData("data/demo_dna.nex")
data_coi <- readDiscreteCharacterData("data/demo_dna.nex")
taxa <- data_cytb.taxa()
num_taxa <- data_cytb.ntaxa()
num_branches <- 2 * num_taxa - 3
num_partitions <- 2

moves    = VectorMoves()
monitors = VectorMonitors()


#################################
# Partition Substitution Models #
#################################

pi_prior_cytb <- v(1,1,1,1)
pi_cytb ~ dnDirichlet(pi_prior_cytb)
moves.append( mvBetaSimplex(pi_cytb, weight=2) )
moves.append( mvDirichletSimplex(pi_cytb, weight=1) )
er_prior_cytb <- v(1,1,1,1,1,1)
er_cytb ~ dnDirichlet(er_prior_cytb)
moves.append( mvBetaSimplex(er_cytb, weight=3) )
Q_cytb := fnGTR(er_cytb, pi_cytb)
alpha_cytb ~ dnUniform(0.0, 10.0)
moves.append( mvScale(alpha_cytb, weight=2) )
site_rates_cytb := fnDiscretizeGamma(alpha_cytb, alpha_cytb, 4)

pi_prior_coi <- v(1,1,1,1)
pi_coi ~ dnDirichlet(pi_prior_coi)
moves.append( mvBetaSimplex(pi_coi, weight=2) )
moves.append( mvDirichletSimplex(pi_coi, weight=1) )
kappa_coi ~ dnLognormal(0.0, 1.0)
moves.append( mvScale(kappa_coi, weight=1) )
Q_coi := fnHKY(kappa_coi, pi_coi)


##############
# Tree Model #
##############

topology ~ dnUniformTopology(taxa)
moves.append( mvNNI(topology, weight=num_taxa/2.0) )
moves.append( mvSPR(topology, weight=num_taxa/10.0) )

for (i in 1:num_branches) {
    bl[i] ~ dnExponential(10)
    moves.append( mvScale(bl[i], weight=1) )
}

psi := fnTreeAssembly(topology, bl)


################################
# Partitioned PhyloCTMC Models #
################################

seq_cytb ~ dnPhyloCTMC(tree=psi, Q=Q_cytb, type="DNA", siteRates=site_rates_cytb)
seq_cytb.clamp(data_cytb)

seq_coi ~ dnPhyloCTMC(tree=psi, Q=Q_coi, type="DNA")
seq_coi.clamp(data_coi)


############
# Analysis #
############

mymodel = model(seq_cytb, seq_coi)

# NOTE: create the output directory before running, e.g. mkdir -p "output"

monitors.append( mnModel(filename="output/partition_dna_cytb.log", printgen=10) )
monitors.append( mnModel(filename="output/partition_dna_coi.log", printgen=10) )
monitors.append( mnFile(filename="output/partition_dna.trees", printgen=10, psi) )
monitors.append( mnScreen(printgen=100) )

mymcmc = mcmc(model=mymodel, monitors=monitors, moves=moves, moveschedule="random")
mymcmc.run(generations=10000, tuningInterval=100)
mymcmc.operatorSummary()

# Quit RevBayes after the analysis
q()
