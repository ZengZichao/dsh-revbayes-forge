################################################################################
# dna_gtr_g_i
# Generated by dsh-revbayes-forge 0.1.0
# Analysis: dna / GTR +G4 +I
# Data: data/demo_dna.nex
#
# Review this script and the paths before running it. The data file must be
# readable from the working directory in which RevBayes is started.
################################################################################


#######################
# Reading in the Data #
#######################

data <- readDiscreteCharacterData("data/demo_dna.nex")
taxa <- data.taxa()
num_taxa <- data.ntaxa()
num_branches <- 2 * num_taxa - 3

moves    = VectorMoves()
monitors = VectorMonitors()


######################
# Substitution Model #
######################

# GTR rate matrix

pi <- simplex(v(0.3,0.2,0.2,0.3))
er <- simplex(v(1,2,1,1,2,1))

Q := fnGTR(er, pi)


#############################
# Among-Site Rate Variation #
#############################

alpha ~ dnUniform(0.0, 10.0)
moves.append( mvScale(alpha, weight=2) )
site_rates := fnDiscretizeGamma(alpha, alpha, 4)

p_inv ~ dnBeta(1.0, 1.0)
moves.append( mvSlide(p_inv, weight=1) )


##############
# Tree Model #
##############

out_group = clade("Taxon_A", "Taxon_B")
topology ~ dnUniformTopology(taxa, outgroup=out_group)
moves.append( mvNNI(topology, weight=num_taxa/2.0) )
moves.append( mvSPR(topology, weight=num_taxa/10.0) )

# Branch lengths: iid exponential priors
for (i in 1:num_branches) {
    bl[i] ~ dnExponential(10)
    moves.append( mvScale(bl[i], weight=1) )
}

psi := fnTreeAssembly(topology, bl)


###################
# PhyloCTMC Model #
###################

seq ~ dnPhyloCTMC(tree=psi, Q=Q, type="DNA", siteRates=site_rates, pInv=p_inv)

# Attach the observed data to the CTMC node
seq.clamp(data)


############
# Analysis #
############

mymodel = model(seq)

# NOTE: create the output directory before running, e.g. mkdir -p "output"

monitors.append( mnModel(filename="output/dna_gtr_g_i.log", printgen=50) )
monitors.append( mnFile(filename="output/dna_gtr_g_i.trees", printgen=50, psi) )
monitors.append( mnScreen(printgen=100) )

mymcmc = mcmc(model=mymodel, monitors=monitors, moves=moves, moveschedule="random", nruns=2, combine="mixed")
mymcmc.run(generations=50000, tuningInterval=100)
mymcmc.operatorSummary()

# Quit RevBayes after the analysis
q()
