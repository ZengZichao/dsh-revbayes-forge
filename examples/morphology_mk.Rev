################################################################################
# morphology_mk
# Generated by dsh-revbayes-forge 0.1.0
# Analysis: morphology / JC +G4
# Data: data/demo_morph.nex
#
# Review this script and the paths before running it. The data file must be
# readable from the working directory in which RevBayes is started.
################################################################################


#######################
# Reading in the Data #
#######################

data <- readDiscreteCharacterData("data/demo_morph.nex")
taxa <- data.taxa()
num_taxa <- data.ntaxa()
num_branches <- 2 * num_taxa - 3

moves    = VectorMoves()
monitors = VectorMonitors()


######################
# Substitution Model #
######################

# Jukes-Cantor / Mk rate matrix with 2 states
Q <- fnJC(2)


#############################
# Among-Site Rate Variation #
#############################

alpha ~ dnUniform(0.0, 10.0)
moves.append( mvScale(alpha, weight=2) )
site_rates := fnDiscretizeGamma(alpha, alpha, 4)


##############
# Tree Model #
##############

topology ~ dnUniformTopology(taxa)
moves.append( mvNNI(topology, weight=num_taxa/2.0) )
moves.append( mvSPR(topology, weight=num_taxa/10.0) )

# Branch lengths: iid exponential priors
for (i in 1:num_branches) {
    bl[i] ~ dnExponential(10)
    moves.append( mvScale(bl[i], weight=1) )
}

psi := fnTreeAssembly(topology, bl)


###################
# PhyloCTMC Model #
###################

seq ~ dnPhyloCTMC(tree=psi, Q=Q, type="Standard", siteRates=site_rates)

# Attach the observed data to the CTMC node
seq.clamp(data)


############
# Analysis #
############

mymodel = model(seq)

# NOTE: create the output directory before running, e.g. mkdir -p "output"

monitors.append( mnModel(filename="output/morphology_mk.log", printgen=10) )
monitors.append( mnFile(filename="output/morphology_mk.trees", printgen=10, psi) )
monitors.append( mnScreen(printgen=100) )

mymcmc = mcmc(model=mymodel, monitors=monitors, moves=moves, moveschedule="random")
mymcmc.run(generations=20000, tuningInterval=100)
mymcmc.operatorSummary()

# Quit RevBayes after the analysis
q()
