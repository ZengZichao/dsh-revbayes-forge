################################################################################
# dna_fixed_tree
# Generated by dsh-revbayes-forge 0.1.0
# Analysis: dna / HKY
# Data: data/demo_dna.nex
#
# Review this script and the paths before running it. The data file must be
# readable from the working directory in which RevBayes is started.
################################################################################


#######################
# Reading in the Data #
#######################

data <- readDiscreteCharacterData("data/demo_dna.nex")
taxa <- data.taxa()
num_taxa <- data.ntaxa()
num_branches <- 2 * num_taxa - 3

moves    = VectorMoves()
monitors = VectorMonitors()


######################
# Substitution Model #
######################

# HKY rate matrix

pi_prior <- v(1,1,1,1)
pi ~ dnDirichlet(pi_prior)
moves.append( mvBetaSimplex(pi, weight=2) )
moves.append( mvDirichletSimplex(pi, weight=1) )
kappa ~ dnLognormal(0.0, 1.0)
moves.append( mvScale(kappa, weight=1) )

Q := fnHKY(kappa, pi)


##############
# Tree Model #
##############

tree_file <- "data/demo.tre"
psi <- readTrees(tree_file, treetype="non-clock")[1]

# Branch lengths are taken from the fixed tree.


###################
# PhyloCTMC Model #
###################

seq ~ dnPhyloCTMC(tree=psi, Q=Q, type="DNA")

# Attach the observed data to the CTMC node
seq.clamp(data)


############
# Analysis #
############

mymodel = model(seq)

# NOTE: create the output directory before running, e.g. mkdir -p "output"

monitors.append( mnModel(filename="output/dna_fixed_tree.log", printgen=10) )
monitors.append( mnFile(filename="output/dna_fixed_tree.trees", printgen=10, psi) )
monitors.append( mnScreen(printgen=100) )

mymcmc = mcmc(model=mymodel, monitors=monitors, moves=moves, moveschedule="random")
mymcmc.run(generations=20000, tuningInterval=100)
mymcmc.operatorSummary()

# Quit RevBayes after the analysis
q()
