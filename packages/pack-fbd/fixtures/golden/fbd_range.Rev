################################################################################
# fbd_range_demo
# Fossilized birth-death range analysis
# Generated by dsh-revbayes-forge 0.1.0
# Analysis: fbd/fbd_range
# Data: data/dinosaur_ranges.tsv
#
# Review this script and the paths before running it. The data file must be
# readable from the working directory in which RevBayes is started.
################################################################################


##################################################
# Reading Stratigraphic Ranges and Fossil Counts #
##################################################

taxa = readTaxonData(file = "data/dinosaur_ranges.tsv")
k <- readDataDelimitedFile(file = "data/dinosaur_fossil_counts.tsv", header = true, rownames = true)
timeline <- v(100, 145, 201)
moves    = VectorMoves()
monitors = VectorMonitors()
alpha <- 10

######################################
# Fossilized Birth-Death Range Model #
######################################

for (i in 1:(timeline.size()+1)) {
    mu[i] ~ dnExp(alpha)
    lambda[i] ~ dnExp(alpha)
    psi[i] ~ dnExp(alpha)
    div[i] := lambda[i] - mu[i]
    turnover[i] := mu[i]/lambda[i]
    moves.append( mvScale(mu[i], lambda=0.01) )
    moves.append( mvScale(mu[i], lambda=0.1) )
    moves.append( mvScale(mu[i], lambda=1) )
    moves.append( mvScale(lambda[i], lambda=0.01) )
    moves.append( mvScale(lambda[i], lambda=0.1) )
    moves.append( mvScale(lambda[i], lambda=1) )
    moves.append( mvScale(psi[i], lambda=0.01) )
    moves.append( mvScale(psi[i], lambda=0.1) )
    moves.append( mvScale(psi[i], lambda=1) )
}
rho <- 0
bd ~ dnFBDRMatrix(taxa=taxa, lambda=lambda, mu=mu, psi=psi, rho=rho, timeline=timeline, k=k)
moves.append( mvMatrixElementScale(bd, lambda=0.01, weight=taxa.size()) )
moves.append( mvMatrixElementScale(bd, lambda=0.1, weight=taxa.size()) )
moves.append( mvMatrixElementScale(bd, lambda=1, weight=taxa.size()) )
moves.append( mvMatrixElementSlide(bd, delta=0.01, weight=taxa.size()) )
moves.append( mvMatrixElementSlide(bd, delta=0.1, weight=taxa.size()) )
moves.append( mvMatrixElementSlide(bd, delta=1, weight=taxa.size()) )

#####################
# Monitors and MCMC #
#####################

mymodel = model(bd)

monitors.append( mnScreen(lambda, mu, psi, printgen=100) )
monitors.append( mnModel(filename="output/fbd_range_demo.log", printgen=10) )
monitors.append( mnFile(filename="output/fbd_range_demo_speciation_rates.log", lambda, printgen=10) )
monitors.append( mnFile(filename="output/fbd_range_demo_extinction_rates.log", mu, printgen=10) )
monitors.append( mnFile(filename="output/fbd_range_demo_sampling_rates.log", psi, printgen=10) )

mymcmc = mcmc(model=mymodel, monitors=monitors, moves=moves, moveschedule="random")
mymcmc.run(generations=30000, tuningInterval=100)
mymcmc.operatorSummary()

q()
