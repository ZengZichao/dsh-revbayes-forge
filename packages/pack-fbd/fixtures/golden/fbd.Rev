################################################################################
# fbd_demo
# Fossilized birth-death analysis
# Generated by dsh-revbayes-forge 0.1.0
# Analysis: fbd/fbd
# Data: data/bears_morphology.nex
#
# Review this script and the paths before running it. The data file must be
# readable from the working directory in which RevBayes is started.
################################################################################


#####################################
# Reading Fossil and Character Data #
#####################################

taxa <- readTaxonData("data/bears_taxa.tsv")
morpho <- readDiscreteCharacterData("data/bears_morphology.nex")
n_taxa <- taxa.size()
moves    = VectorMoves()
monitors = VectorMonitors()

#####################################
# Fossilized Birth-Death Tree Prior #
#####################################

speciation_rate ~ dnExponential(10)
extinction_rate ~ dnExponential(5)
moves.append( mvScale(speciation_rate, weight=1) )
moves.append( mvScale(extinction_rate, weight=1) )
diversification := speciation_rate - extinction_rate
turnover := extinction_rate/speciation_rate
rho <- 1
psi ~ dnExponential(10)
moves.append( mvScale(psi, weight=1) )
origin_time ~ dnUniform(22.5, 67.5)
moves.append( mvSlide(origin_time, weight=1.0) )
fbd_tree ~ dnFBDP(origin=origin_time, lambda=speciation_rate, mu=extinction_rate, psi=psi, rho=rho, taxa=taxa)
moves.append( mvFNPR(fbd_tree, weight=15.0) )
moves.append( mvCollapseExpandFossilBranch(fbd_tree, origin_time, weight=6.0) )
moves.append( mvNodeTimeSlideUniform(fbd_tree, weight=40.0) )
moves.append( mvRootTimeSlideUniform(fbd_tree, origin_time, weight=5.0) )
num_samp_anc := fbd_tree.numSampledAncestors()

################################
# Substitution and Clock Model #
################################

Q_morpho <- fnJC(2)

alpha_morpho ~ dnExponential( 1.0 )
rates_morpho := fnDiscretizeGamma( alpha_morpho, alpha_morpho, 4 )
moves.append( mvScale(alpha_morpho, weight=5.0) )

clock_morpho ~ dnExponential(1.0)
moves.append( mvScale(clock_morpho, weight=4.0) )

phyMorpho ~ dnPhyloCTMC(tree=fbd_tree, siteRates=rates_morpho, branchRates=clock_morpho, Q=Q_morpho, type="Standard")
phyMorpho.clamp(morpho)

############
# Monitors #
############

mymodel = model(fbd_tree)

monitors.append( mnModel(filename="output/fbd_demo.log", printgen=10) )
monitors.append( mnFile(filename="output/fbd_demo.trees", printgen=10, fbd_tree) )
monitors.append( mnScreen(printgen=100, origin_time, num_samp_anc) )

#################
# MCMC Analysis #
#################

mymcmc = mcmc(model=mymodel, monitors=monitors, moves=moves)
mymcmc.run(generations=20000, tuningInterval=100)
mymcmc.operatorSummary()

q()
