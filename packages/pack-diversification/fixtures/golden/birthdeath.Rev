################################################################################
# bd_demo
# Constant-rate birth-death analysis
# Generated by dsh-revbayes-forge 0.1.0
# Analysis: diversification/birthdeath
# Data: data/tree.tre
#
# Review this script and the paths before running it. The data file must be
# readable from the working directory in which RevBayes is started.
################################################################################


#########################
# Reading the Time Tree #
#########################

T <- readTrees("data/tree.tre")[1]
taxa <- T.taxa()
moves    = VectorMoves()
monitors = VectorMonitors()

#####################
# Birth-Death Model #
#####################

birth_rate ~ dnUniform(0, 1)
death_rate ~ dnUniform(0, 0.5)
moves.append( mvScale(birth_rate, lambda=1.0, tune=true, weight=3.0) )
moves.append( mvScale(death_rate, lambda=1.0, tune=true, weight=3.0) )
diversification := birth_rate - death_rate
rel_extinction  := death_rate / birth_rate
rho <- 1
root_time <- T.rootAge()
timetree ~ dnBDP(lambda=birth_rate, mu=death_rate, rho=rho, rootAge=root_time, samplingStrategy="uniform", condition="survival", taxa=taxa)
timetree.clamp(T)

#####################
# Monitors and MCMC #
#####################

mymodel = model(birth_rate)

monitors.append( mnModel(filename="output/bd_demo.log", printgen=10) )
monitors.append( mnFile(filename="output/bd_demo.trees", printgen=10, timetree) )
monitors.append( mnScreen(printgen=100, birth_rate, death_rate, diversification) )

mymcmc = mcmc(model=mymodel, monitors=monitors, moves=moves, moveschedule="random")
mymcmc.run(generations=20000, tuningInterval=100)
mymcmc.operatorSummary()

# Quit RevBayes after the analysis
q()
