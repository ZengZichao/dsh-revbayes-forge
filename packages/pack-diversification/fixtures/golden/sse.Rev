################################################################################
# sse_demo
# State-dependent diversification (SSE) analysis
# Generated by dsh-revbayes-forge 0.1.0
# Analysis: diversification/sse
# Data: data/states.nex
#
# Review this script and the paths before running it. The data file must be
# readable from the working directory in which RevBayes is started.
################################################################################


#########################################
# Reading the Tree and Character States #
#########################################

NUM_STATES = 2
observed_phylogeny <- readTrees("data/tree.tre")[1]
data_states <- readDiscreteCharacterData("data/states.nex")
num_taxa <- observed_phylogeny.ntips()
moves    = VectorMoves()
monitors = VectorMonitors()
NUM_HIDDEN_STATES = 2
NUM_FEATURES = 1

#########################################
# State-Dependent Diversification Rates #
#########################################

for (i in 1:NUM_STATES) {
    speciation[i] ~ dnLoguniform( 1E-6, 1E2)
    moves.append( mvScale(speciation[i], lambda=0.20, tune=true, weight=3.0) )
    extinction[i] ~ dnLoguniform( 1E-6, 1E2)
    moves.append( mvScale(extinction[i], lambda=0.20, tune=true, weight=3.0) )
    diversification[i] := speciation[i] - extinction[i]
}
rate_pr := observed_phylogeny.treeLength() / 10
for ( i in 1:(NUM_STATES*(NUM_STATES-1)) ) {
    transition_rates[i] ~ dnExp(rate_pr)
    moves.append( mvScale(transition_rates[i], lambda=0.20, tune=true, weight=3.0) )
}
rate_matrix := fnFreeBinary( transition_rates, rescaled=false)
root_state_freq ~ dnDirichlet( rep(1,NUM_STATES) )
moves.append( mvDirichletSimplex(root_state_freq, tune=true, weight=2) )
root_age <- observed_phylogeny.rootAge()
sampling <- 0.5
timetree ~ dnCDBDP( rootAge=root_age, speciationRates=speciation, extinctionRates=extinction, Q=rate_matrix, pi=root_state_freq, delta=1.0, rho=sampling, condition="time")
timetree.clamp(observed_phylogeny)

#####################
# Monitors and MCMC #
#####################

mymodel = model(timetree)

monitors.append( mnModel(filename="output/sse_demo.log", printgen=10) )
monitors.append( mnFile(filename="output/sse_demo.trees", printgen=10, timetree) )
monitors.append( mnScreen(printgen=100, speciation, extinction) )

mymcmc = mcmc(model=mymodel, monitors=monitors, moves=moves, moveschedule="random")
mymcmc.run(generations=20000, tuningInterval=100)
mymcmc.operatorSummary()

# Quit RevBayes after the analysis
q()
