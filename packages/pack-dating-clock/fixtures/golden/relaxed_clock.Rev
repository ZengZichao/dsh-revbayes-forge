################################################################################
# dating_relaxed
# Molecular dating analysis
# Generated by dsh-revbayes-forge 0.1.0
# Analysis: dating/relaxed_clock
# Data: data/dna.nex
#
# Review this script and the paths before running it. The data file must be
# readable from the working directory in which RevBayes is started.
################################################################################


##################################
# Reading the Data and Time Tree #
##################################

data <- readDiscreteCharacterData("data/dna.nex")
taxa <- data.taxa()
num_taxa <- data.ntaxa()
num_branches <- 2 * num_taxa - 2
moves    = VectorMoves()
monitors = VectorMonitors()

timetree <- readTrees("data/tree.tre")[1]
n_branches <- 2 * num_taxa - 2

######################
# Substitution Model #
######################

pi_prior <- v(1,1,1,1)
pi ~ dnDirichlet(pi_prior)
moves.append( mvBetaSimplex(pi, weight=2) )
kappa ~ dnLognormal(0.0, 1.0)
moves.append( mvScale(kappa, weight=1) )
Q := fnHKY(kappa, pi)

alpha ~ dnUniform(0.0, 10.0)
moves.append( mvScale(alpha, weight=2) )
site_rates := fnDiscretizeGamma(alpha, alpha, 4)

###############
# Clock Model #
###############

branch_rates_mean ~ dnExponential(10.0)
moves.append( mvScale(branch_rates_mean, lambda=0.5, tune=true, weight=3.0) )
ln_branch_rates_mean := ln( branch_rates_mean )
branch_rates_sd ~ dnUniform(0.0, 4*0.587405)
moves.append( mvScale(branch_rates_sd, lambda=0.5, tune=true, weight=3.0) )
for (i in 1:n_branches) {
    branch_rates[i] ~ dnLognormal(ln_branch_rates_mean, sd=branch_rates_sd)
    moves.append( mvScale(branch_rates[i], lambda=0.5, tune=true, weight=1.0) )
}
moves.append( mvVectorScale(branch_rates, lambda=0.5, tune=true, weight=4.0) )

################
# Calibrations #
################

# No node calibrations were supplied; the tree ages are fixed by the input tree.

###################
# PhyloCTMC Model #
###################

seq ~ dnPhyloCTMC(tree=timetree, Q=Q, branchRates=branch_rates, siteRates=site_rates, type="DNA")
seq.clamp(data)

#####################
# Monitors and MCMC #
#####################

mymodel = model(seq)

monitors.append( mnModel(filename="output/dating_relaxed.log", printgen=10) )
monitors.append( mnFile(filename="output/dating_relaxed.trees", printgen=10, timetree) )
monitors.append( mnScreen(printgen=100, clock_rate, alpha) )

mymcmc = mcmc(model=mymodel, monitors=monitors, moves=moves, moveschedule="random")
mymcmc.run(generations=20000, tuningInterval=100)
mymcmc.operatorSummary()

# Quit RevBayes after the analysis
q()
