################################################################################
# dating_relative
# Dating with relative node-age constraints
# Generated by dsh-revbayes-forge 0.1.0
# Analysis: dating/relative_constraints
# Data: data/dna.nex
#
# Review this script and the paths before running it. The data file must be
# readable from the working directory in which RevBayes is started.
################################################################################


####################################
# Reading the Data and Constraints #
####################################

data <- readDiscreteCharacterData("data/dna.nex")
observed_tree <- readTrees("data/tree.tre")[1]
taxa <- observed_tree.taxa()
num_taxa <- observed_tree.ntips()
n_branches <- 2 * num_taxa - 2
moves    = VectorMoves()
monitors = VectorMonitors()
constraints <- readRelativeNodeAgeConstraints(file="data/constraints.txt")

######################
# Substitution Model #
######################

Q <- fnJC(4)

alpha ~ dnUniform(0.0, 10.0)
moves.append( mvScale(alpha, weight=2) )
site_rates := fnDiscretizeGamma(alpha, alpha, 4)

########################################
# Tree Prior with Relative Constraints #
########################################

birth_rate ~ dnExponential(10.0)
moves.append( mvScale(birth_rate, lambda=1.0, tune=true, weight=3.0) )
root_time <- observed_tree.rootAge()
psi ~ dnConstrainedNodeOrder(dnBDP(lambda=birth_rate, mu=0.0, rho=1.0, rootAge=root_time, samplingStrategy="uniform", condition="survival", taxa=taxa), constraints)
psi.setValue(observed_tree)
moves.append( mvNarrow(psi, weight=num_taxa/2.0) )
moves.append( mvNNI(psi, weight=num_taxa/5.0) )
moves.append( mvFNPR(psi, weight=num_taxa/10.0) )
moves.append( mvNodeTimeSlideUniform(psi, weight=num_taxa) )

###############
# Clock Model #
###############

clock_rate ~ dnExponential(1)
moves.append( mvScale(clock_rate, lambda=0.5, tune=true, weight=3.0) )
branch_rates := rep(clock_rate, n_branches)

###################
# PhyloCTMC Model #
###################

seq ~ dnPhyloCTMC(tree=psi, Q=Q, branchRates=branch_rates, siteRates=site_rates, type="DNA")
seq.clamp(data)

#####################
# Monitors and MCMC #
#####################

mymodel = model(seq)

monitors.append( mnModel(filename="output/dating_relative.log", printgen=10) )
monitors.append( mnFile(filename="output/dating_relative.trees", printgen=10, psi) )
monitors.append( mnScreen(printgen=100, branch_rates) )

mymcmc = mcmc(model=mymodel, monitors=monitors, moves=moves, moveschedule="random")
mymcmc.run(generations=20000, tuningInterval=100)
mymcmc.operatorSummary()

# Quit RevBayes after the analysis
q()
