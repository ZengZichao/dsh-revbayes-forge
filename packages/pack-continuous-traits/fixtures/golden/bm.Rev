################################################################################
# bm_demo
# Continuous trait evolution
# Generated by dsh-revbayes-forge 0.1.0
# Analysis: traits/bm
# Data: data/traits.nex
#
# Review this script and the paths before running it. The data file must be
# readable from the working directory in which RevBayes is started.
################################################################################


###############################
# Reading the Tree and Traits #
###############################

T <- readTrees("data/tree.tre")[1]
data <- readContinuousCharacterData("data/traits.nex")
data.excludeAll()
data.includeCharacter(1)
taxa <- data.taxa()
num_taxa <- data.ntaxa()
num_branches <- 2 * num_taxa - 2
moves    = VectorMoves()
monitors = VectorMonitors()

tree <- T

#########################
# Brownian Motion Model #
#########################

sigma2 ~ dnLoguniform(1e-5, 1)
moves.append( mvScale(sigma2, weight=1.0) )
X ~ dnPhyloBrownianREML(tree, branchRates=sqrt(sigma2))
X.clamp(data)

#####################
# Monitors and MCMC #
#####################

mymodel = model(sigma2)

monitors.append( mnModel(filename="output/bm_demo.log", printgen=10) )
monitors.append( mnScreen(printgen=100, sigma2) )

mymcmc = mcmc(model=mymodel, monitors=monitors, moves=moves, moveschedule="random")
mymcmc.run(generations=20000, tuningInterval=100)
mymcmc.operatorSummary()

# Quit RevBayes after the analysis
q()
