################################################################################
# chromosse_demo
# ChromoSSE analysis
# Generated by dsh-revbayes-forge 0.1.0
# Analysis: chromosome/chromosse
# Data: data/chromo.tsv
#
# Review this script and the paths before running it. The data file must be
# readable from the working directory in which RevBayes is started.
################################################################################


######################################
# Reading Chromosome Counts and Tree #
######################################

moves    = VectorMoves()
monitors = VectorMonitors()

phylogeny <- readTrees("data/tree.tre")[1]
max_chromo = 30
chromo_data = readCharacterDataDelimited("data/chromo.tsv", stateLabels=(max_chromo + 1), type="NaturalNumbers", separator="\t", header=FALSE)
num_taxa = phylogeny.ntips()
num_branches = 2 * num_taxa - 2

###################
# ChromoSSE Model #
###################

speciation_rates <- rep(0.1, max_chromo + 1)
rate_multipliers <- rep(1.0, max_chromo + 1)
clado_events := fnChromosomesCladoEventsBD(speciation_rates, rate_multipliers, max_chromo)
clado_probs := fnChromosomesCladoProbs(simplex(1,1,1,1,1), max_chromo)
Q := fnChromosomes(max_chromo, 1.0, 1.0, 0.1)
chromo_ctmc ~ dnPhyloCTMCClado(tree=phylogeny, Q=Q, cladoProbs=clado_probs, type="NaturalNumbers", nSites=1)
chromo_ctmc.clamp(chromo_data)
birth_rate ~ dnExponential(1.0)
death_rate ~ dnExponential(1.0)
moves.append( mvScale(birth_rate, weight=2) )
moves.append( mvScale(death_rate, weight=2) )
timetree ~ dnBDP(lambda=birth_rate, mu=death_rate, rho=1.0, rootAge=phylogeny.rootAge(), samplingStrategy="uniform", condition="survival", taxa=phylogeny.taxa())
timetree.clamp(phylogeny)

#####################
# Monitors and MCMC #
#####################

mymodel = model(chromo_ctmc)

monitors.append( mnScreen(printgen=100, birth_rate, death_rate) )
monitors.append( mnModel(filename="output/chromosse_demo_model.log", printgen=10) )
monitors.append( mnJointConditionalAncestralState(filename="output/chromosse_demo_anc_states.log", printgen=10, tree=phylogeny, ctmc=chromo_ctmc, type="NaturalNumbers") )

mymcmc = mcmc(model=mymodel, monitors=monitors, moves=moves)
mymcmc.run(generations=20000, tuningInterval=100)
mymcmc.operatorSummary()

q()
