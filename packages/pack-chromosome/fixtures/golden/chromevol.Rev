################################################################################
# chromevol_demo
# ChromEvol analysis
# Generated by dsh-revbayes-forge 0.1.0
# Analysis: chromosome/chromevol
# Data: data/chromo.tsv
#
# Review this script and the paths before running it. The data file must be
# readable from the working directory in which RevBayes is started.
################################################################################


######################################
# Reading Chromosome Counts and Tree #
######################################

moves    = VectorMoves()
monitors = VectorMonitors()

phylogeny <- readTrees("data/tree.tre")[1]
max_chromo = 30
chromo_data = readCharacterDataDelimited("data/chromo.tsv", stateLabels=(max_chromo + 1), type="NaturalNumbers", separator="\t", header=FALSE)
num_taxa = phylogeny.ntips()
num_branches = 2 * num_taxa - 2

###################
# ChromEvol Model #
###################

gamma ~ dnExponential(1)
delta ~ dnExponential(1)
rho ~ dnExponential(10)
moves.append( mvScale(gamma, lambda=1, weight=1) )
moves.append( mvScale(delta, lambda=1, weight=1) )
moves.append( mvScale(rho, lambda=1, weight=1) )
Q := fnChromosomes(max_chromo, gamma, delta, rho)
root_frequencies := simplex(rep(1, max_chromo + 1))
chromo_ctmc ~ dnPhyloCTMC(Q=Q, tree=phylogeny, rootFrequencies=root_frequencies, type="NaturalNumbers")
chromo_ctmc.clamp(chromo_data)

#####################
# Monitors and MCMC #
#####################

mymodel = model(phylogeny)

monitors.append( mnScreen(printgen=100) )
monitors.append( mnJointConditionalAncestralState(filename="output/chromevol_demo_anc_states.log", printgen=10, tree=phylogeny, ctmc=chromo_ctmc, type="NaturalNumbers") )
monitors.append( mnModel(filename="output/chromevol_demo_model.log", printgen=10) )

mymcmc = mcmc(model=mymodel, monitors=monitors, moves=moves)
mymcmc.run(generations=20000, tuningInterval=100)
mymcmc.operatorSummary()

q()
