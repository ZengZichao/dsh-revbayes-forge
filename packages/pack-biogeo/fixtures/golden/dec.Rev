################################################################################
# dec_demo
# DEC biogeographic analysis
# Generated by dsh-revbayes-forge 0.1.0
# Analysis: biogeo/dec
# Data: data/ranges.nex
#
# Review this script and the paths before running it. The data file must be
# readable from the working directory in which RevBayes is started.
################################################################################


######################################
# Reading Geographic Ranges and Tree #
######################################

dat_range_01 = readDiscreteCharacterData("data/ranges.nex")
dat_range_n = formatDiscreteCharacterData(dat_range_01, "DEC")
n_areas = dat_range_01.nchar()
n_states = floor(2^n_areas)
tree <- readTrees("data/tree.tre")[1]
num_taxa = tree.ntips()
moves    = VectorMoves()
monitors = VectorMonitors()

###########################
# DEC Biogeographic Model #
###########################

rate_bg ~ dnLoguniform(1E-4,1E2)
rate_bg.setValue(1E-2)
moves.append( mvScale(rate_bg, weight=4) )
dispersal_rate <- 1
for (i in 1:n_areas) {
    for (j in 1:n_areas) {
        dr[i][j] <- dispersal_rate
    }
}
extirpation_rate ~ dnLognormal(mean=ln(0.1) - 0.5*0.5^2, sd=0.5)
moves.append( mvScale(extirpation_rate, weight=2) )
for (i in 1:n_areas) {
    for (j in 1:n_areas) {
        er[i][j] <- 0.0
    }
    er[i][i] := extirpation_rate
}
Q_DEC := fnDECRateMatrix(dispersalRates=dr, extirpationRates=er)
clado_event_types <- [ "s", "a" ]
clado_event_probs <- simplex(1,1)
P_DEC := fnDECCladoProbs(eventProbs=clado_event_probs, eventTypes=clado_event_types, numCharacters=n_areas)
m_bg ~ dnPhyloCTMCClado(tree=tree, Q=Q_DEC, cladoProbs=P_DEC, branchRates=rate_bg, type="NaturalNumbers", nSites=1)
m_bg.clamp(dat_range_n)

#####################
# Monitors and MCMC #
#####################

mymodel = model(m_bg)

monitors.append( mnScreen(printgen=100, rate_bg) )
monitors.append( mnModel(filename="output/dec_demo.log", printgen=10) )
monitors.append( mnFile(tree, filename="output/dec_demo.tre", printgen=10) )
monitors.append( mnJointConditionalAncestralState(tree=tree, ctmc=m_bg, type="NaturalNumbers", withTips=true, withStartStates=true, filename="output/dec_demo.states.log", printgen=10) )

mymcmc = mcmc(model=mymodel, monitors=monitors, moves=moves)
mymcmc.run(generations=20000, tuningInterval=100)
mymcmc.operatorSummary()

q()
