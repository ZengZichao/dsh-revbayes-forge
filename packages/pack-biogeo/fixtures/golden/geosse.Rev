################################################################################
# geosse_demo
# GeoSSE-style biogeographic analysis
# Generated by dsh-revbayes-forge 0.1.0
# Analysis: biogeo/geosse
# Data: data/ranges.nex
#
# Review this script and the paths before running it. The data file must be
# readable from the working directory in which RevBayes is started.
################################################################################


######################################
# Reading Geographic Ranges and Tree #
######################################

dat_range_01 = readDiscreteCharacterData("data/ranges.nex")
dat_range_n = formatDiscreteCharacterData(dat_range_01, "DEC")
n_areas = dat_range_01.nchar()
n_states = floor(2^n_areas)
tree <- readTrees("data/tree.tre")[1]
num_taxa = tree.ntips()
moves    = VectorMoves()
monitors = VectorMonitors()

####################################
# GeoSSE-Style Biogeographic Model #
####################################

rate_bg ~ dnLoguniform(1E-4,1E2)
moves.append( mvScale(rate_bg, weight=4) )
for (i in 1:n_areas) {
    for (j in 1:n_areas) {
        dr[i][j] <- 1
    }
}
for (i in 1:n_areas) {
    er[i] := 0.1
}
Q_geo := fnBiogeographyRateMatrix(dispersalRates=dr, extirpationRates=er, maxRangeSize=n_areas)
clado_probs <- fnDECCladoProbs(eventProbs=simplex(1,1), eventTypes=["s", "a"], numCharacters=n_areas)
m_bg ~ dnPhyloCTMCClado(tree=tree, Q=Q_geo, cladoProbs=clado_probs, branchRates=rate_bg, type="NaturalNumbers", nSites=1)
m_bg.clamp(dat_range_n)

#####################
# Monitors and MCMC #
#####################

mymodel = model(m_bg)

monitors.append( mnScreen(printgen=100, rate_bg) )
monitors.append( mnModel(filename="output/geosse_demo.log", printgen=10) )
monitors.append( mnFile(tree, filename="output/geosse_demo.tre", printgen=10) )
monitors.append( mnJointConditionalAncestralState(tree=tree, ctmc=m_bg, type="NaturalNumbers", withTips=true, withStartStates=true, filename="output/geosse_demo.states.log", printgen=10) )

mymcmc = mcmc(model=mymodel, monitors=monitors, moves=moves)
mymcmc.run(generations=20000, tuningInterval=100)
mymcmc.operatorSummary()

q()
