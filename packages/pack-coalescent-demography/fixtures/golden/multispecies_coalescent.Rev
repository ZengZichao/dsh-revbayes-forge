################################################################################
# msc_demo
# Multispecies coalescent analysis
# Generated by dsh-revbayes-forge 0.1.0
# Analysis: coalescent/multispecies_coalescent
# Data: data/dna.nex
#
# Review this script and the paths before running it. The data file must be
# readable from the working directory in which RevBayes is started.
################################################################################


#####################################
# Reading Data and the Species Tree #
#####################################

data <- readDiscreteCharacterData("data/dna.nex")
taxa <- data.taxa()
observed_species_tree <- readTrees("data/tree.tre")[1]
species_tree <- observed_species_tree
num_species <- species_tree.ntips()
moves    = VectorMoves()
monitors = VectorMonitors()

#####################################
# Multispecies Coalescent Gene Tree #
#####################################

mean_Ne ~ dnGamma(1.0, 1.0)
mean_Ne.setValue(0.01)
moves.append( mvScale(mean_Ne, lambda=1.0, tune=true, weight=2.0) )
gene_tree ~ dnMultiSpeciesCoalescent(speciesTree=species_tree, Ne=mean_Ne, taxa=taxa)
moves.append( mvNNI(gene_tree, weight=num_species/2.0) )
moves.append( mvNarrow(gene_tree, weight=num_species/10.0) )
moves.append( mvFNPR(gene_tree, weight=num_species/10.0) )
moves.append( mvSubtreeScale(gene_tree, weight=num_species/10.0) )
moves.append( mvNodeTimeSlideUniform(gene_tree, weight=num_species) )

################################
# Clock and Substitution Model #
################################

clock_rate ~ dnUniform(0.0, 100.0)
clock_rate.setValue(1e-4)
moves.append( mvSlide(clock_rate, delta=0.01, weight=1.0) )
Q <- fnJC(4)

seq ~ dnPhyloCTMC(tree=gene_tree, Q=Q, branchRates=clock_rate, type="DNA")
seq.clamp(data)

#####################
# Monitors and MCMC #
#####################

mymodel = model(gene_tree)

monitors.append( mnModel(filename="output/msc_demo.log", printgen=10) )
monitors.append( mnFile(filename="output/msc_demo.trees", printgen=10, gene_tree) )
monitors.append( mnScreen(printgen=100, mean_Ne, clock_rate) )

mymcmc = mcmc(model=mymodel, monitors=monitors, moves=moves, moveschedule="random")
mymcmc.run(generations=20000, tuningInterval=100)
mymcmc.operatorSummary()

# Quit RevBayes after the analysis
q()
