################################################################################
# skyline_demo
# Coalescent skyline analysis
# Generated by dsh-revbayes-forge 0.1.0
# Analysis: coalescent/skyline
# Data: data/dna.nex
#
# Review this script and the paths before running it. The data file must be
# readable from the working directory in which RevBayes is started.
################################################################################


##################################
# Reading the Data and Gene Tree #
##################################

data <- readDiscreteCharacterData("data/dna.nex")
taxa <- data.taxa()
num_taxa <- data.ntaxa()
moves    = VectorMoves()
monitors = VectorMonitors()
observed_tree <- readTrees("data/tree.tre")[1]

############################
# Coalescent Skyline Model #
############################

for (k in 1:4) {
    theta[k] ~ dnLoguniform(1e-5, 1e5)
    moves.append( mvScale(theta[k], weight=2) )
}
times <- v(0, 10, 20, 30)
events_per_interval <- v(10, 10, 10, 10)
coalescent_tree ~ dnCoalescentSkyline(theta=theta, times=times, events_per_interval=events_per_interval, method="events", model="constant", taxa=taxa)
coalescent_tree.clamp(observed_tree)

###############################
# Substitution Model and CTMC #
###############################

pi_prior <- v(1,1,1,1)
pi ~ dnDirichlet(pi_prior)
moves.append( mvBetaSimplex(pi, weight=2) )
kappa ~ dnLognormal(0.0, 1.0)
moves.append( mvScale(kappa, weight=1) )
Q := fnHKY(kappa, pi)
seq ~ dnPhyloCTMC(tree=coalescent_tree, Q=Q, type="DNA")
seq.clamp(data)

#####################
# Monitors and MCMC #
#####################

mymodel = model(seq)

monitors.append( mnModel(filename="output/skyline_demo.log", printgen=10) )
monitors.append( mnFile(filename="output/skyline_demo.trees", printgen=10, coalescent_tree) )
monitors.append( mnScreen(printgen=100, theta) )

mymcmc = mcmc(model=mymodel, monitors=monitors, moves=moves, moveschedule="random")
mymcmc.run(generations=20000, tuningInterval=100)
mymcmc.operatorSummary()

# Quit RevBayes after the analysis
q()
