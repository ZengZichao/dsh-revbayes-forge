################################################################################
# stairway_demo
# StairwayPlot demographic analysis
# Generated by dsh-revbayes-forge 0.1.0
# Analysis: coalescent/stairwayplot
#
# Review this script and the paths before running it. The data file must be
# readable from the working directory in which RevBayes is started.
################################################################################


#######################################
# Reading the Site Frequency Spectrum #
#######################################

obs_sfs = [ 100, 50, 30, 20, 10 ]
N_IND   = 2*abs(obs_sfs.size()-1)
N_SITES = round(sum(obs_sfs))
moves     = VectorMoves()
monitors  = VectorMonitors()

#####################
# Demographic Model #
#####################

avmvn = mvAVMVN(weight=100)
for (k in 1:4) {
  theta[k] ~ dnUnif( 0.0, 0.1 )
  moves.append( mvScale(theta[k], weight=10) )
  avmvn.addVariable(theta[k])
}
moves.append( avmvn )

#################
# Stairway Plot #
#################

sfs ~ dnStairwayPlot( theta, numSites=N_SITES, numIndividuals=N_IND, folded=TRUE, coding="all" )
sfs.clamp( obs_sfs )
times := sfs.getTimes()
mu <- 2.8e-9
GEN_TIME <- 2
ordered_Ne    := rev(theta) / 4.0 / mu
ordered_times := rev(times) / mu * GEN_TIME
esfs := sfs.getExpectedAlleleFrequencies()

#####################
# Monitors and MCMC #
#####################

my_model = model(sfs)

monitors.append( mnModel(filename="output/stairway_demo.log", printgen=10) )
monitors.append( mnFile(ordered_Ne, filename="output/stairway_demo_ordered_Ne.log", printgen=10) )
monitors.append( mnFile(ordered_times, filename="output/stairway_demo_ordered_times.log", printgen=10) )
monitors.append( mnFile(esfs, filename="output/stairway_demo_esfs.log", printgen=10) )
monitors.append( mnScreen(printgen=100) )

my_mcmc = mcmc(model=my_model, monitors=monitors, moves=moves, nruns=1, combine="mixed")
my_mcmc.run(generations=20000, tuningInterval=100)
my_mcmc.operatorSummary()

q()
