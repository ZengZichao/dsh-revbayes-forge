################################################################################
# smap_demo
# Stochastic character mapping
# Generated by dsh-revbayes-forge 0.1.0
# Analysis: morphology/stochastic_map
# Data: data/morph.nex
#
# Review this script and the paths before running it. The data file must be
# readable from the working directory in which RevBayes is started.
################################################################################


###############################
# Reading Morphology and Tree #
###############################

morpho <- readDiscreteCharacterData("data/morph.nex")
taxa <- morpho.taxa()
num_taxa <- morpho.ntaxa()
num_branches <- 2 * num_taxa - 3
moves    = VectorMoves()
monitors = VectorMonitors()

tree <- readTrees("data/tree.tre")[1]

######################
# Morphological CTMC #
######################

Q <- fnJC(2)
clock_rate ~ dnExponential(1.0)
moves.append( mvScale(clock_rate, weight=4.0) )

seq ~ dnPhyloCTMC(tree=tree, Q=Q, branchRates=clock_rate, type="Standard")
seq.clamp(morpho)
moves.append( mvCharacterHistory(ctmc=seq, qmap_site=Q, lambda=0.2, graph="branch", proposal="rejection", weight=num_branches) )

#####################
# Monitors and MCMC #
#####################

mymodel = model(seq)

monitors.append( mnModel(filename="output/smap_demo.log", printgen=10) )
monitors.append( mnFile(filename="output/smap_demo.trees", printgen=10, tree) )
monitors.append( mnStochasticCharacterMap(ctmc=seq, filename="output/smap_demo.stoch.log", printgen=10) )
monitors.append( mnScreen(printgen=100, clock_rate) )

mymcmc = mcmc(model=mymodel, monitors=monitors, moves=moves, moveschedule="random")
mymcmc.run(generations=20000, tuningInterval=100)
mymcmc.operatorSummary()

# Quit RevBayes after the analysis
q()

#########################
# Character Map Summary #
#########################

char_map_trace = readAncestralStateTrace("output/smap_demo.stoch.log")
summarizeCharacterMaps(tree, char_map_trace, "output/smap_demo_char_map.tree", burnin=0.25)
