################################################################################
# mkv_demo
# Mkv morphological analysis
# Generated by dsh-revbayes-forge 0.1.0
# Analysis: morphology/mkv
# Data: data/morph.nex
#
# Review this script and the paths before running it. The data file must be
# readable from the working directory in which RevBayes is started.
################################################################################


###############################
# Reading Morphology and Tree #
###############################

morpho <- readDiscreteCharacterData("data/morph.nex")
taxa <- morpho.taxa()
num_taxa <- morpho.ntaxa()
num_branches <- 2 * num_taxa - 3
moves    = VectorMoves()
monitors = VectorMonitors()

tree <- readTrees("data/tree.tre")[1]

##########################
# Mkv Substitution Model #
##########################

Q <- fnJC(2)
clock_rate ~ dnExponential(1.0)
moves.append( mvScale(clock_rate, weight=4.0) )

seq ~ dnPhyloCTMC(tree=tree, Q=Q, branchRates=clock_rate, type="Standard", coding="variable")
seq.clamp(morpho)

#####################
# Monitors and MCMC #
#####################

mymodel = model(seq)

monitors.append( mnModel(filename="output/mkv_demo.log", printgen=10) )
monitors.append( mnScreen(printgen=100, clock_rate) )

mymcmc = mcmc(model=mymodel, monitors=monitors, moves=moves, moveschedule="random")
mymcmc.run(generations=20000, tuningInterval=100)
mymcmc.operatorSummary()

# Quit RevBayes after the analysis
q()
