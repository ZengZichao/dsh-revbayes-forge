################################################################################
# asr_demo
# Morphological ancestral state reconstruction
# Generated by dsh-revbayes-forge 0.1.0
# Analysis: morphology/ancestral_state
# Data: data/morph.nex
#
# Review this script and the paths before running it. The data file must be
# readable from the working directory in which RevBayes is started.
################################################################################


###############################
# Reading Morphology and Tree #
###############################

morpho <- readDiscreteCharacterData("data/morph.nex")
taxa <- morpho.taxa()
num_taxa <- morpho.ntaxa()
num_branches <- 2 * num_taxa - 3
moves    = VectorMoves()
monitors = VectorMonitors()

tree <- readTrees("data/tree.tre")[1]

######################
# Morphological CTMC #
######################

Q <- fnJC(2)
clock_rate ~ dnExponential(1.0)
moves.append( mvScale(clock_rate, weight=4.0) )

seq ~ dnPhyloCTMC(tree=tree, Q=Q, branchRates=clock_rate, type="Standard")
seq.clamp(morpho)

#####################
# Monitors and MCMC #
#####################

mymodel = model(seq)

monitors.append( mnModel(filename="output/asr_demo.log", printgen=10) )
monitors.append( mnFile(filename="output/asr_demo.trees", printgen=10, tree) )
monitors.append( mnJointConditionalAncestralState(tree=tree, ctmc=seq, type="Standard", withTips=true, withStartStates=true, filename="output/asr_demo.anc_states.log", printgen=10) )
monitors.append( mnScreen(printgen=100, clock_rate) )

mymcmc = mcmc(model=mymodel, monitors=monitors, moves=moves, moveschedule="random")
mymcmc.run(generations=20000, tuningInterval=100)
mymcmc.operatorSummary()

# Quit RevBayes after the analysis
q()

###########################
# Ancestral State Summary #
###########################

anc_state_trace = readAncestralStateTrace("output/asr_demo.anc_states.log")
ancestralStateTree(tree, anc_state_trace, "output/asr_demo_ancestral.tree", burnin=0.25, reconstruction="marginal")
