data <- readDiscreteCharacterData("data/dna.nex")
taxa <- data.taxa()
num_taxa <- data.ntaxa()
num_branches <- 2 * num_taxa - 3
moves    = VectorMoves()
monitors = VectorMonitors()
Q <- fnJC(4)
topology ~ dnUniformTopology(taxa)
moves.append( mvNNI(topology, weight=num_taxa/2.0) )
for (i in 1:num_branches) {
    bl[i] ~ dnExponential(10.0)
    moves.append( mvScale(bl[i]) )
}
psi := fnTreeAssembly(topology, bl)
seq ~ dnPhyloCTMC(tree=psi, Q=Q, type="DNA")
seq.clamp(data)
mymodel = model(seq)

# Marginal likelihood estimation
pow_p = powerPosterior(mymodel, moves, monitors, "output/model_selection/sel_ss.out", cats=10, sampleFreq=10)
pow_p.burnin(generations=100, tuningInterval=100)
pow_p.run(generations=100)

# Stepping-stone sampling
ss = steppingStoneSampler(filename="output/model_selection/sel_ss.out", powerColumnName="power", likelihoodColumnName="likelihood")
ss.marginal()

q()
