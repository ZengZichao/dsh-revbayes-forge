################################################################################
# codon_demo
# Codon dN/dS selection analysis
# Generated by dsh-revbayes-forge 0.1.0
# Analysis: molecular/codon_selection
# Data: data/codon.nex
#
# Review this script and the paths before running it. The data file must be
# readable from the working directory in which RevBayes is started.
################################################################################


###############################
# Reading Codon Data and Tree #
###############################

data = readDiscreteCharacterData("data/codon.nex")
data_codon = data.translateCharacters("Codon")
n_species <- data.ntaxa()
taxa <- data.taxa()
moves    = VectorMoves()
monitors = VectorMonitors()

psi <- readTrees("data/tree.tre")[1]

############################
# Codon Substitution Model #
############################

kappa ~ dnLognormal(ln(2), 1.0)
moves.append( mvSlide(kappa, delta=1.0, tune=true, weight=2.0) )
pi ~ dnDirichlet( rep(1,4) )
moves.append( mvBetaSimplex(pi, alpha=1.0, tune=true, weight=2.0) )
moves.append( mvDirichletSimplex(pi, alpha=1.0, tune=true, weight=2.0) )

omega_negative ~ dnBeta(1,1)
moves.append( mvSlide(omega_negative, delta=1.0, tune=true, weight=2.0) )
Q_negative := fnCodonHKY( omega_negative, kappa, pi )

omega_neutral <- 1.0
Q_neutral := fnCodonHKY( omega_neutral, kappa, pi )

omega_positive ~ dnExponential(1.0, offset=1.0)
moves.append( mvSlide(omega_positive, delta=1.0, tune=true, weight=2.0) )
Q_positive := fnCodonHKY( omega_positive, kappa, pi )

Q := [Q_negative, Q_neutral, Q_positive]
seq ~ dnPhyloCTMC(tree=psi, Q=Q, siteMatrices=simplex(rep(1,Q.size())), type="Codon")
seq.clamp(data_codon)

#####################
# Monitors and MCMC #
#####################

mymodel = model(psi)

monitors.append( mnModel(filename="output/codon_demo.log", printgen=10) )
monitors.append( mnFile(filename="output/codon_demo.trees", printgen=10, psi) )
monitors.append( mnScreen(printgen=100, omega_negative, omega_neutral, omega_positive) )

mymcmc = mcmc(model=mymodel, monitors=monitors, moves=moves, moveschedule="random")
mymcmc.run(generations=20000, tuningInterval=100)
mymcmc.operatorSummary()

# Quit RevBayes after the analysis
q()
