################################################################################
# pomo_demo
# PoMo analysis
# Generated by dsh-revbayes-forge 0.1.0
# Analysis: molecular/pomo
# Data: data/pomo.txt
#
# Review this script and the paths before running it. The data file must be
# readable from the working directory in which RevBayes is started.
################################################################################


###############################################
# Reading PoMo Allele-Frequency Data and Tree #
###############################################

data_pomo <- readPoMoCountFile("data/pomo.txt", virtualPopulationSize=10, numStates=10)
taxa <- data_pomo.taxa()
n_species <- data_pomo.ntaxa()
moves    = VectorMoves()
monitors = VectorMonitors()

psi <- readTrees("data/tree.tre")[1]

##############
# PoMo Model #
##############

base_frequencies ~ dnDirichlet( rep(1,4) )
moves.append( mvBetaSimplex(base_frequencies, weight=2) )
exchange_rates ~ dnDirichlet( rep(1,6) )
moves.append( mvBetaSimplex(exchange_rates, weight=2) )
Q := fnReversiblePoMo(base_frequencies, exchange_rates, virtualNe=10)
seq ~ dnPhyloCTMC(tree=psi, Q=Q, type="PoMo", nSites=data_pomo.nchar())
seq.clamp(data_pomo)

#####################
# Monitors and MCMC #
#####################

mymodel = model(seq)

monitors.append( mnModel(filename="output/pomo_demo.log", printgen=10) )
monitors.append( mnFile(filename="output/pomo_demo.trees", printgen=10, psi) )
monitors.append( mnScreen(printgen=100, base_frequencies) )

mymcmc = mcmc(model=mymodel, monitors=monitors, moves=moves, moveschedule="random")
mymcmc.run(generations=20000, tuningInterval=100)
mymcmc.operatorSummary()

# Quit RevBayes after the analysis
q()
